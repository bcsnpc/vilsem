{
  "meta": {
    "id": "diverging_bar",
    "name": "Diverging Bar",
    "description": "One measure per category; bars extend right for positive, left for negative, coloured by sign. Bind 1 dimension + 1 (signed) measure.",
    "author": "vilsem",
    "version": "1.0.0",
    "icon": "↔️"
  },
  "slots": {
    "category": { "kind": "dimension", "count": 1, "constraints": { "maxCardinality": 30 } },
    "value": { "kind": "measure", "count": 1 }
  },
  "params": [
    { "name": "positiveColor", "type": "color", "default": "#3FB68B" },
    { "name": "negativeColor", "type": "color", "default": "#E06C6C" }
  ],
  "template": {
    "grid": { "left": 8, "right": 12, "top": 14, "bottom": 40, "containLabel": true },
    "tooltip": { "trigger": "item" },
    "xAxis": {
      "type": "category",
      "data": "$slot.category.categories",
      "axisLabel": { "color": "$theme.textMuted", "fontSize": 9, "interval": 0, "rotate": 30 },
      "axisLine": { "lineStyle": { "color": "$theme.gridStroke" } }
    },
    "yAxis": {
      "type": "value",
      "axisLabel": { "color": "$theme.textMuted", "fontSize": 9 },
      "splitLine": { "lineStyle": { "color": "$theme.gridStroke" } }
    },
    "visualMap": {
      "show": false,
      "type": "piecewise",
      "pieces": [
        { "lte": 0, "color": "$param.negativeColor" },
        { "gt": 0, "color": "$param.positiveColor" }
      ]
    },
    "series": [
      {
        "type": "bar",
        "data": "$slot.value.values",
        "label": { "show": true, "position": "top", "color": "$theme.textMuted", "fontSize": 9, "formatterTemplate": "{value:thousands}" }
      }
    ]
  },
  "themeBindings": {}
}
