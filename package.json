{
  "name": "vilsem",
  "version": "1.0.0-beta.3",
  "description": "vilsem — Microsoft Fabric desktop query engine",
  "author": "vilsem",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "vitest run",
    "electron": "node scripts/launch-electron.js",
    "electron:dev": "concurrently \"npm run ui:dev\" \"wait-on http://localhost:5173 && node scripts/launch-electron.js --dev\"",
    "ui:dev": "cd ui && npm run dev",
    "ui:build": "cd ui && npm run build",
    "standalone:build": "cd ui && npx vite build --config vite.standalone.config.js",
    "fabric-embed:build": "cd ui && npx vite build --config vite.fabric-embed.config.js",
    "build": "npm run powerbi:build && npm run ui:build && npm run fabric-embed:build && electron-builder --publish never",
    "powerbi:build": "npm --prefix vilsem-renderer run package",
    "qa:native": "node scripts/qa/run-native.cjs",
    "core:build": "npm run build --workspace @vilsem/core",
    "pretest": "npm run core:build",
    "preui:build": "npm run core:build",
    "prepowerbi:build": "npm run core:build",
    "postpowerbi:build": "node packages/core/scripts/copy-renderer.mjs"
  },
  "build": {
    "appId": "com.semantica.app",
    "productName": "vilsem",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "dist/ui/**/*",
      "dist/app/**/*",
      "dist/fabric-embed/**/*",
      "vilsem-renderer/dist/*.pbiviz",
      "node_modules/**/*",
      "package.json",
      "!.env",
      "!.env.*",
      "!.auth/**",
      "!cache/**",
      "!staging/**",
      "!*.db",
      "!Adventure/**",
      "!**/*.md",
      "!dist/app/win-unpacked/**",
      "!dist/app/builder-debug.yml",
      "!release/**",
      "!export/**",
      "packages/core/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/ui",
        "to": "ui"
      }
    ],
    "asarUnpack": [
      "vilsem-renderer/dist/**",
      "dist/fabric-embed/**",
      "packages/core/src/connect/*.ps1",
      "node_modules/@vilsem/core/src/connect/*.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@vilsem/core": "0.8.2",
    "adm-zip": "0.6.1",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "fast-xml-parser": "^5.5.10",
    "fastify": "^5.3.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@microsoft/powerbi-desktop-bridge-cli": "1.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "9.2.5",
    "cross-env": "^7.0.3",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "powerbi-visuals-utils-testutils": "7.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wait-on": "^8.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
