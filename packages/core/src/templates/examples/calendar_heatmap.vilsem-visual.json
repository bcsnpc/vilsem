{
  "meta": {
    "id": "calendar_heatmap",
    "name": "Calendar Heatmap",
    "description": "A daily measure laid out on a calendar, coloured by value. Bind a date field + 1 measure — the calendar auto-fits the data's date span.",
    "author": "vilsem",
    "version": "1.0.0",
    "icon": "📅"
  },
  "slots": {
    "time": { "kind": "time", "count": 1, "constraints": { "maxCardinality": 800 } },
    "value": { "kind": "measure", "count": 1 }
  },
  "params": [
    { "name": "minColor", "type": "color", "default": "#12303A" },
    { "name": "maxColor", "type": "color", "default": "#58AECB" }
  ],
  "template": {
    "tooltip": { "trigger": "item" },
    "calendar": {
      "top": 30,
      "left": 24,
      "right": 24,
      "cellSize": ["auto", 13],
      "range": "$slot.time.dateRange",
      "itemStyle": { "borderColor": "$theme.background", "color": "transparent", "borderWidth": 1 },
      "dayLabel": { "color": "$theme.textMuted", "fontSize": 9 },
      "monthLabel": { "color": "$theme.textMuted", "fontSize": 10 },
      "yearLabel": { "show": false },
      "splitLine": { "lineStyle": { "color": "$theme.gridStroke" } }
    },
    "visualMap": {
      "type": "continuous",
      "min": "$slot.value.min",
      "max": "$slot.value.max",
      "orient": "horizontal",
      "left": "center",
      "bottom": 6,
      "inRange": { "color": ["$param.minColor", "$param.maxColor"] },
      "textStyle": { "color": "$theme.textMuted", "fontSize": 9 }
    },
    "series": [
      { "type": "heatmap", "coordinateSystem": "calendar", "data": "$slot.value.pairs" }
    ]
  },
  "themeBindings": {}
}
