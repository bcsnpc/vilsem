{
  "meta": {
    "id": "heat_strip",
    "name": "Heat Strip",
    "description": "One measure across time as a single row of cells, coloured by value. Bind a time field + 1 measure.",
    "author": "vilsem",
    "version": "1.0.0",
    "icon": "🔥"
  },
  "slots": {
    "time": { "kind": "time", "count": 1, "constraints": { "maxCardinality": 120 } },
    "value": { "kind": "measure", "count": 1 }
  },
  "params": [
    { "name": "minColor", "type": "color", "default": "#0E1E2A" },
    { "name": "maxColor", "type": "color", "default": "#58AECB" }
  ],
  "template": {
    "grid": { "left": 8, "right": 8, "top": 10, "bottom": 52, "containLabel": true },
    "tooltip": { "trigger": "item" },
    "xAxis": {
      "type": "category",
      "data": "$slot.time.categories",
      "axisLabel": { "color": "$theme.textMuted", "fontSize": 8, "rotate": 45 },
      "axisLine": { "lineStyle": { "color": "$theme.gridStroke" } },
      "splitArea": { "show": false }
    },
    "yAxis": {
      "type": "category",
      "data": [" "],
      "axisLine": { "show": false },
      "axisTick": { "show": false },
      "splitArea": { "show": false }
    },
    "visualMap": {
      "type": "continuous",
      "min": "$slot.value.min",
      "max": "$slot.value.max",
      "calculable": true,
      "orient": "horizontal",
      "left": "center",
      "bottom": 6,
      "inRange": { "color": ["$param.minColor", "$param.maxColor"] },
      "textStyle": { "color": "$theme.textMuted", "fontSize": 9 }
    },
    "series": [
      {
        "type": "heatmap",
        "data": "$slot.value.cells",
        "label": { "show": false },
        "itemStyle": { "borderColor": "$theme.background", "borderWidth": 1 }
      }
    ]
  },
  "themeBindings": {}
}
