{
  "privileges": [],
  "dataRoles": [
    {
      "displayName": "Content",
      "name": "content",
      "kind": "Measure",
      "description": "Primary measure. Returns HTML (legacy KPI/HTML mode) OR a numeric value (chart mode + new primitive mode)."
    },
    {
      "displayName": "Secondary",
      "name": "secondary",
      "kind": "Measure",
      "description": "Phase 5.2: optional second measure. Used by stacked/grouped bars, line+secondary, scatter, bubble. Maps to _val2 in the primitive runtime."
    },
    {
      "displayName": "Tertiary",
      "name": "tertiary",
      "kind": "Measure",
      "description": "Phase 5.2: optional third measure. Used by bubble (size dimension). Maps to _val3 in the primitive runtime."
    },
    {
      "displayName": "Measure 4",
      "name": "quaternary",
      "kind": "Measure",
      "description": "Optional template measure 4; preserves host-evaluated DAX values."
    },
    {
      "displayName": "Measure 5",
      "name": "quinary",
      "kind": "Measure",
      "description": "Optional template measure 5; preserves host-evaluated DAX values."
    },
    {
      "displayName": "Measure 6",
      "name": "senary",
      "kind": "Measure",
      "description": "Optional template measure 6; preserves host-evaluated DAX values."
    },
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional. Bind a category/date column for chart mode and primitive mode."
    },
    {
      "displayName": "Category 2",
      "name": "category2",
      "kind": "Grouping",
      "description": "Optional second dimension column. Used by table visual for multi-dimension display."
    },
    {
      "displayName": "Category 3",
      "name": "category3",
      "kind": "Grouping",
      "description": "Optional third dimension column. Used by table visual for multi-dimension display."
    },
    {
      "displayName": "Category 4",
      "name": "category4",
      "kind": "Grouping",
      "description": "Optional fourth dimension column. Used by table visual for multi-dimension display."
    },
    {
      "displayName": "Category 5",
      "name": "category5",
      "kind": "Grouping",
      "description": "Optional fifth dimension column. Used by table visual for multi-dimension display."
    },
    {
      "displayName": "Category 6",
      "name": "category6",
      "kind": "Grouping",
      "description": "Optional sixth dimension column. Used by table visual for multi-dimension display."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "content": {
            "min": 1,
            "max": 10
          },
          "secondary": {
            "min": 0,
            "max": 1
          },
          "tertiary": {
            "min": 0,
            "max": 1
          },
          "category": {
            "min": 0,
            "max": 1
          },
          "category2": {
            "min": 0,
            "max": 1
          },
          "category3": {
            "min": 0,
            "max": 1
          },
          "category4": {
            "min": 0,
            "max": 1
          },
          "category5": {
            "min": 0,
            "max": 1
          },
          "category6": {
            "min": 0,
            "max": 1
          },
          "quaternary": {
            "min": 0,
            "max": 1
          },
          "quinary": {
            "min": 0,
            "max": 1
          },
          "senary": {
            "min": 0,
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "category"
              }
            },
            {
              "bind": {
                "to": "category2"
              }
            },
            {
              "bind": {
                "to": "category3"
              }
            },
            {
              "bind": {
                "to": "category4"
              }
            },
            {
              "bind": {
                "to": "category5"
              }
            },
            {
              "bind": {
                "to": "category6"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 2000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "content"
              }
            },
            {
              "bind": {
                "to": "secondary"
              }
            },
            {
              "bind": {
                "to": "tertiary"
              }
            },
            {
              "bind": {
                "to": "quaternary"
              }
            },
            {
              "bind": {
                "to": "quinary"
              }
            },
            {
              "bind": {
                "to": "senary"
              }
            }
          ]
        }
      }
    }
  ],
